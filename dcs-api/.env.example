DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/dcs?schema=public"
PORT=8080
LOG_LEVEL="info"
RATE_LIMIT_PER_SECOND=200
RATE_LIMIT_BURST_PER_SECOND=400
RATE_LIMIT_BURST_DURATION=10
VALIDATE_P95_MS=150
VALIDATE_P99_MS=300
WEBHOOK_RETRY_MAX_HOURS=24
OPS_BEARER_TOKEN="change-me-ops-token"
# OPS_BEARER_TOKEN_FILE="/run/secrets/dcs_ops_token"   # alternative: read token from a mounted file (vault-injectable)

# ---- TLS / mTLS (leave disabled for plain-HTTP dev; enable for corridors) ----
# TLS_ENABLED="true"
# TLS_CERT_FILE="/etc/dcs/tls/server.crt"
# TLS_KEY_FILE="/etc/dcs/tls/server.key"
# TLS_CA_FILE="/etc/dcs/tls/corridor-ca.crt"
# TLS_REQUEST_CLIENT_CERT="true"
# TLS_REJECT_UNAUTHORIZED="true"

# ---- Outbound mTLS for webhook delivery to gateways ----
# WEBHOOK_CLIENT_CERT_FILE="/etc/dcs/tls/webhook-client.crt"
# WEBHOOK_CLIENT_KEY_FILE="/etc/dcs/tls/webhook-client.key"
# WEBHOOK_CA_FILE="/etc/dcs/tls/gateway-ca.crt"