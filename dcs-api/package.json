{
  "name": "dcs-api",
  "version": "0.1.0",
  "description": "Digital Consumer Shield - Real-time recipient verification, fraud detection and transaction hold/freeze/block API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
